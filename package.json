{
  "name": "codex-companion",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "在 Codex 桌面端（macOS）注入红果短剧、Emby、小游戏、代理状态与任务看板卡片",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foriLLL/codex_companion.git"
  },
  "homepage": "https://github.com/foriLLL/codex_companion#readme",
  "bugs": {
    "url": "https://github.com/foriLLL/codex_companion/issues"
  },
  "keywords": [
    "codex",
    "emby",
    "macos"
  ],
  "packageManager": "npm@11.6.0",
  "scripts": {
    "start": "node src/cli.mjs agent install",
    "prestart": "npm run generate:renderer",
    "start:legacy": "node src/cli.mjs launch",
    "attach": "node src/cli.mjs attach",
    "inject": "node src/cli.mjs inject",
    "unmount": "node src/cli.mjs unmount",
    "smoke": "node scripts/smoke-chromium.mjs",
    "smoke:placement": "node scripts/smoke-placement.mjs",
    "probe:emby": "node scripts/probe-emby.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test": "node --test",
    "generate:renderer": "node scripts/generate-renderer.mjs",
    "prestart:legacy": "npm run generate:renderer",
    "preattach": "npm run generate:renderer",
    "preinject": "npm run generate:renderer",
    "pretest": "npm run generate:renderer",
    "smoke:platform": "node scripts/smoke-card-platform.mjs",
    "card:create": "node scripts/create-card.mjs",
    "smoke:backend": "node scripts/smoke-backend-platform.mjs",
    "presmoke": "npm run generate:renderer"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "mp4box": "2.4.1",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "bun": "1.3.14"
  }
}
