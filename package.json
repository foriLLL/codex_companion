{
  "name": "codex-companion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "通过 CDP 向 Codex Desktop 注入短剧与 Emby 微型播放器卡片",
  "scripts": {
    "start": "node src/cli.mjs launch",
    "attach": "node src/cli.mjs attach",
    "inject": "node src/cli.mjs inject",
    "unmount": "node src/cli.mjs unmount",
    "smoke": "node scripts/smoke-chromium.mjs",
    "smoke:placement": "node scripts/smoke-placement.mjs",
    "probe:emby": "node scripts/probe-emby.mjs",
    "generate:hls": "node scripts/generate-hls-embed.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "hls.js": "1.6.16",
    "mp4box": "2.4.1",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "bun": "^1.3.14"
  }
}
